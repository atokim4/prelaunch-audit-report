diff --git a/supabase/migrations/20261116090501_org_policies_organization_members.sql b/supabase/migrations/20261116090501_org_policies_organization_members.sql
new file mode 100644
--- /dev/null
+++ b/supabase/migrations/20261116090501_org_policies_organization_members.sql
@@ -0,0 +1,42 @@
+-- PA-01: rows of public.organization_members belong to an organization (public.organizations); tie every policy to membership.
+-- Generated by prelaunch-audit. Review before applying.
+-- Membership helpers. SECURITY DEFINER so they read the membership table without its policies
+-- (a policy that queries its own table recurses); search_path pinned; not callable by visitors.
+create or replace function public.is_org_member(target_org uuid)
+returns boolean
+language sql stable security definer
+set search_path = ''
+as $$
+  select exists (select 1 from public.organization_members m where m.organization_id = target_org and m.user_id = (select auth.uid()));
+$$;
+revoke execute on function public.is_org_member(uuid) from public, anon;
+grant execute on function public.is_org_member(uuid) to authenticated;
+
+create or replace function public.has_org_role(target_org uuid, allowed text[])
+returns boolean
+language sql stable security definer
+set search_path = ''
+as $$
+  select exists (select 1 from public.organization_members m where m.organization_id = target_org and m.user_id = (select auth.uid()) and m.role::text = any (allowed));
+$$;
+revoke execute on function public.has_org_role(uuid, text[]) from public, anon;
+grant execute on function public.has_org_role(uuid, text[]) to authenticated;
+
+drop policy if exists "Users can update their membership" on public.organization_members;
+drop policy if exists "Users can join organizations" on public.organization_members;
+
+drop policy if exists "Org admins can add organization_members" on public.organization_members;
+create policy "Org admins can add organization_members"
+  on public.organization_members for insert
+  to authenticated
+  with check (public.has_org_role(organization_id, array['owner', 'admin']));
+
+drop policy if exists "Org admins can change organization_members" on public.organization_members;
+create policy "Org admins can change organization_members"
+  on public.organization_members for update
+  to authenticated
+  using (public.has_org_role(organization_id, array['owner', 'admin']))
+  with check (public.has_org_role(organization_id, array['owner', 'admin']));
+
+revoke update on public.organization_members from anon, authenticated;
+grant update (role) on public.organization_members to authenticated;
