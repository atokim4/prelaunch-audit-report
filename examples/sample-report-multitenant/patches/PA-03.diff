diff --git a/supabase/migrations/20261116090503_org_policies_organizations.sql b/supabase/migrations/20261116090503_org_policies_organizations.sql
new file mode 100644
--- /dev/null
+++ b/supabase/migrations/20261116090503_org_policies_organizations.sql
@@ -0,0 +1,35 @@
+-- PA-03: rows of public.organizations belong to an organization (public.organizations); tie every policy to membership.
+-- Generated by prelaunch-audit. Review before applying.
+-- Membership helpers. SECURITY DEFINER so they read the membership table without its policies
+-- (a policy that queries its own table recurses); search_path pinned; not callable by visitors.
+create or replace function public.is_org_member(target_org uuid)
+returns boolean
+language sql stable security definer
+set search_path = ''
+as $$
+  select exists (select 1 from public.organization_members m where m.organization_id = target_org and m.user_id = (select auth.uid()));
+$$;
+revoke execute on function public.is_org_member(uuid) from public, anon;
+grant execute on function public.is_org_member(uuid) to authenticated;
+
+create or replace function public.has_org_role(target_org uuid, allowed text[])
+returns boolean
+language sql stable security definer
+set search_path = ''
+as $$
+  select exists (select 1 from public.organization_members m where m.organization_id = target_org and m.user_id = (select auth.uid()) and m.role::text = any (allowed));
+$$;
+revoke execute on function public.has_org_role(uuid, text[]) from public, anon;
+grant execute on function public.has_org_role(uuid, text[]) to authenticated;
+
+drop policy if exists "Members can update their organization" on public.organizations;
+
+drop policy if exists "Org admins can change organizations" on public.organizations;
+create policy "Org admins can change organizations"
+  on public.organizations for update
+  to authenticated
+  using (public.has_org_role(id, array['owner', 'admin']))
+  with check (public.has_org_role(id, array['owner', 'admin']));
+
+revoke update on public.organizations from anon, authenticated;
+grant update (name, slug, created_by) on public.organizations to authenticated;
