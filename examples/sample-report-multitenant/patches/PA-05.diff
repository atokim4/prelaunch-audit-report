diff --git a/supabase/migrations/20261116090505_org_policies_invitations.sql b/supabase/migrations/20261116090505_org_policies_invitations.sql
new file mode 100644
--- /dev/null
+++ b/supabase/migrations/20261116090505_org_policies_invitations.sql
@@ -0,0 +1,21 @@
+-- PA-05: rows of public.invitations belong to an organization (public.organizations); tie every policy to membership.
+-- Generated by prelaunch-audit. Review before applying.
+-- Membership helpers. SECURITY DEFINER so they read the membership table without its policies
+-- (a policy that queries its own table recurses); search_path pinned; not callable by visitors.
+create or replace function public.is_org_member(target_org uuid)
+returns boolean
+language sql stable security definer
+set search_path = ''
+as $$
+  select exists (select 1 from public.organization_members m where m.organization_id = target_org and m.user_id = (select auth.uid()));
+$$;
+revoke execute on function public.is_org_member(uuid) from public, anon;
+grant execute on function public.is_org_member(uuid) to authenticated;
+
+drop policy if exists "Invites are readable by signed-in users" on public.invitations;
+
+drop policy if exists "Org members can read invitations" on public.invitations;
+create policy "Org members can read invitations"
+  on public.invitations for select
+  to authenticated
+  using (public.is_org_member(organization_id));
