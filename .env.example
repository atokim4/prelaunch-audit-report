# Only for --live (the read-only probe of your own Supabase project). Copy to .env.live, fill it in,
# and pass --live-env .env.live. Never commit the filled file.

# The anon (legacy JWT) or publishable (sb_publishable_...) key. The probe refuses secret and service_role keys.
LIVE_SUPABASE_KEY=

# Two throwaway test accounts made for the probe. Give user A at least one row in each table
# (and one file under <user A id>/ in each bucket), so "user B can't see it" means something.
LIVE_USER_A_EMAIL=
LIVE_USER_A_PASSWORD=
LIVE_USER_B_EMAIL=
LIVE_USER_B_PASSWORD=
